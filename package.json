{
  "name": "practice-field-configurator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend",
    "test": "bun test",
    "build": "tsc && cd frontend && bun run build",
    "package": "bun run build && bun scripts/package-binary.ts",
    "dev": "tsx --watch src/index.ts",
    "once": "tsx src/index.ts",
    "start": "node dist"
  },
  "keywords": [
    "FMS",
    "Practice Field",
    "Field Management System",
    "VH-113",
    "VH-109",
    "Cheesy Arena"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com> (https://github.com/cinderblock)",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@slack/socket-mode": "^2.0.6",
    "@slack/web-api": "^7.15.0",
    "cidr-matcher": "^2.1.1",
    "cron": "^3.2.0",
    "first-events-api": "^1.0.5",
    "node-emoji": "^2.2.0",
    "syslog-server": "github:cinderblock/syslog-server",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cidr-matcher": "^2.1.2",
    "@types/node": "^22.13.13",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "lefthook": "^2.1.4",
    "prettier": "^3.6.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.9"
  }
}
