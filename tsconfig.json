{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "preserveConstEnums": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "declaration": false,
    // "noUnusedLocals": true,
    "removeComments": true,
    "esModuleInterop": true,
    // bun-types (for `bun test`) tracks a newer @types/node than we pin;
    // its own .d.ts files don't type-check against ours. Our code still does.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
