# pFMS local development environment
#
# Copy to `.env` and fill in. This file is ONLY read in development —
# `bun run dev` / `bun run start` load it automatically.
#
# It does NOT apply in production: the systemd unit runs
# `/usr/bin/node dist`, which does not read .env. Put production values in
# /etc/pfms/environment instead. See docs/configuration.md.

# Changes nothing outside this machine: network, radio, Driver Station,
# Wi-Fi card, Slack and push writes are logged instead of performed.
# Lets you run the whole app on any OS without root or a real network.
DRY_RUN=1

# FIRST Events API credentials, used to fetch team avatars.
# Register at https://frc-events.firstinspires.org/services/API
# Without these, avatars are silently disabled.
FIRST_API_USERNAME=
FIRST_API_AUTH_TOKEN=

# The radio pFMS polls. Unset means http://10.0.100.2, the field radio: on
# the field network a dry run reads its status (it never writes to it).
# RADIO_URL=http://10.0.100.2

# Uncomment to exercise the FMS server (TCP/1750 + UDP/1160).
# FMS_ENDPOINT=true
